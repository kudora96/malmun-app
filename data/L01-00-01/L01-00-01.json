  "subtitles": [
    {
      "id": 1,
      "start": 4.24,
      "end": 7.88,
      "ko": "어서 오세요. 경복궁에 온 걸 환영해요.",
      "tag": "open",
      "parts": [
        {
          "speaker": "선생님",
          "ko": "어서 오세요. 경복궁에 온 걸 환영해요.",
          "audio": "L01-00-01_01_sub_t1.mp3"
        }
      ]
    },
    {
      "id": 2,
      "start": 11.24,
      "end": 14.79,
      "ko": "선생님! 저 글자 만들었어요!",
      "tag": "open",
      "parts": [
        {
          "speaker": "콩",
          "ko": "선생님! 저 글자 만들었어요!",
          "audio": "L01-00-01_02_sub_t1.mp3"
        }
      ]
    },
    {
      "id": 3,
      "start": 15.05,
      "end": 18.27,
      "ko": "글자요? …이건 그림이에요.",
      "tag": "model",
      "parts": [
        {
          "speaker": "선생님",
          "ko": "글자요? …이건 그림이에요.",
          "audio": "L01-00-01_03_sub_t1.mp3"
        }
      ]
    },
    {
      "id": 4,
      "start": 18.83,
      "end": 21.04,
      "ko": "글자 아니에요? 왜요?",
      "tag": "q",
      "parts": [
        {
          "speaker": "콩",
          "ko": "글자 아니에요? 왜요?",
          "audio": "L01-00-01_04_sub_t1.mp3"
        }
      ]
    },
    {
      "id": 5,
      "start": 21.39,
      "end": 26.12,
      "ko": "글자는 약속이에요. 다 같이 읽을 수 있어야 글자예요.",
      "tag": "model",
      "parts": [
        {
          "speaker": "선생님",
          "ko": "글자는 약속이에요. 다 같이 읽을 수 있어야 글자예요.",
          "audio": "L01-00-01_05_sub_t1.mp3"
        }
      ]
    },
    {
      "id": 6,
      "start": 27.35,
      "end": 31.31,
      "ko": "아, 저 혼자 알면 글자가 아니구나.",
      "tag": "ack",
      "parts": [
        {
          "speaker": "콩",
          "ko": "아, 저 혼자 알면 글자가 아니구나.",
          "audio": "L01-00-01_06_sub_t1.mp3"
        }
      ]
    },
    {
      "id": 7,
      "start": 31.39,
      "end": 33.8,
      "ko": "그럼 그 약속은 누가 정했어요?",
      "tag": "q",
      "parts": [
        {
          "speaker": "두부",
          "ko": "그럼 그 약속은 누가 정했어요?",
          "audio": "L01-00-01_07_sub_t1.mp3"
        }
      ]
    },
    {
      "id": 8,
      "start": 33.88,
      "end": 43.54,
      "ko": "세종대왕이요. 오백 년 전에 왕이 직접 만들었어요. 그때 백성들은 글자를 몰랐거든요. 너무 어려웠어요.",
      "tag": "model",
      "parts": [
        {
          "speaker": "선생님",
          "ko": "세종대왕이요. 오백 년 전에 왕이 직접 만들었어요. 그때 백성들은 글자를 몰랐거든요. 너무 어려웠어요.",
          "audio": "L01-00-01_08_sub_t1.mp3"
        }
      ]
    },
    {
      "id": 9,
      "start": 43.62,
      "end": 46.73,
      "ko": "와! 그럼 다들 좋아했겠네요!",
      "tag": "last",
      "parts": [
        {
          "speaker": "콩",
          "ko": "와! 그럼 다들 좋아했겠네요!",
          "audio": "L01-00-01_09_sub_t1.mp3"
        }
      ]
    },
    {
      "id": 10,
      "start": 48.56,
      "end": 51.83,
      "ko": "아니에요. 신하들이 반대했어요.",
      "tag": "model",
      "parts": [
        {
          "speaker": "선생님",
          "ko": "아니에요. 신하들이 반대했어요.",
          "audio": "L01-00-01_10_sub_t1.mp3"
        }
      ]
    },
    {
      "id": 11,
      "start": 52.19,
      "end": 54.21,
      "ko": "신하들이요? 왜요?",
      "tag": "q",
      "parts": [
        {
          "speaker": "두부",
          "ko": "신하들이요? 왜요?",
          "audio": "L01-00-01_11_sub_t1.mp3"
        }
      ]
    },
    {
      "id": 12,
      "start": 54.53,
      "end": 58.46,
      "ko": "그때는 글자를 아는 사람만 힘이 있었거든요.",
      "tag": "model",
      "parts": [
        {
          "speaker": "선생님",
          "ko": "그때는 글자를 아는 사람만 힘이 있었거든요.",
          "audio": "L01-00-01_12_sub_t1.mp3"
        }
      ]
    },
    {
      "id": 13,
      "start": 58.93,
      "end": 62.11,
      "ko": "그럼 우리는요? 우리도 읽을 수 있어요?",
      "tag": "q",
      "parts": [
        {
          "speaker": "콩",
          "ko": "그럼 우리는요? 우리도 읽을 수 있어요?",
          "audio": "L01-00-01_13_sub_t1.mp3"
        }
      ]
    },
    {
      "id": 14,
      "start": 63.62,
      "end": 73.45,
      "ko": "자, 여기 보세요. 이게 그 글자예요. 「아」예요.",
      "tag": "model",
      "parts": [
        {
          "speaker": "선생님",
          "ko": "자, 여기 보세요. 이게 그 글자예요. 「아」예요.",
          "audio": "L01-00-01_14_sub_t1.mp3"
        }
      ]
    },
    {
      "id": 15,
      "start": 73.75,
      "end": 84.48,
      "ko": "그게 세종대왕이 하고 싶었던 거구나. 누구나 쉽게 읽는 글자요. 그 누구나가 지금 우리예요.",
      "tag": "wrap",
      "parts": [
        {
          "speaker": "두부",
          "ko": "그게 세종대왕이 하고 싶었던 거구나. 누구나 쉽게 읽는 글자요. 그 누구나가 지금 우리예요.",
          "audio": "L01-00-01_15_sub_t1.mp3"
